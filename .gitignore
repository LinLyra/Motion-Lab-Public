# Python / OS
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.env
.env.*
!.env.example
.venv/
venv/
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3

# Local sibling/legacy working copies are separate repositories or datasets.
# Never absorb them into this repository accidentally.
/Lykon/
/skillcorner-basketball-analytics/
/data/lykon_dataset*/
/data/local_capture/
/tmp/

# Local hardware identities and private research manifests.
/configs/device_registry.local.json
/docs/hardware/UWB_DEVICE_REGISTRY.md
/advisor_release/
/advisor_release_*.zip
/Motion-Lab-Public/

# Trained models & binary artifacts
models/*.pkl
models/*.joblib
*.joblib
*.pkl
*.blend1
*.npz

# ---------- KEEP OUT: real / derived sensor data ----------
# Raw captures (IMU / UWB / video / hangtime / our sessions)
data/raw/**/*.csv
data/raw/**/*.mp4
data/raw/**/*.mov
data/raw/**/*.avi
data/raw/**/*.json
data/raw/hangtime/**
!data/raw/hangtime/.gitkeep
!data/raw/**/.gitkeep

# Legacy/live UWB capture location outside data/raw.
data/uwb/**
!data/uwb/.gitkeep

# Processed / interim / labels with real content
data/interim/**
!data/interim/**/.gitkeep
data/processed/**
!data/processed/.gitkeep
!data/processed/**/.gitkeep
data/labels/**
!data/labels/.gitkeep

# Reports, figures, blender outputs from local runs
outputs/**
!outputs/**/.gitkeep
!outputs/reports/.gitkeep
!outputs/figures/.gitkeep
!outputs/blender/.gitkeep

# Notebooks may contain embedded data; keep folder only unless you opt in
notebooks/**
!notebooks/.gitkeep
!notebooks/**/*.md
